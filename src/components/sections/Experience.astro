---
import type { Dict } from "../../i18n";

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;

type Job = {
  id: string;
  company: string;
  when: string;
  role: string;
  type?: string;
  sum: string;
  sys?: string;
  work: string[];
  own?: string;
  result: string;
  tags?: string[];
  current?: boolean;
};

const jobs: Job[] = [
  {
    id: "eminler",
    company: "Əminlər MMC",
    when: `Sep 2026 — ${dict["exp.present"]}`,
    role: dict["exp.eminler.role"],
    sum: dict["exp.eminler.sum"],
    sys: dict["exp.eminler.sys"],
    work: [dict["exp.eminler.w1"], dict["exp.eminler.w2"], dict["exp.eminler.w3"]],
    own: dict["exp.eminler.own"],
    result: dict["exp.eminler.result"],
    tags: [dict["tag.perf"], dict["tag.debug"]],
    current: true,
  },
  {
    id: "qravan",
    company: "QRAVAN LLC",
    when: "Jan 2026 — Aug 2026",
    role: dict["exp.qravan.role"],
    type: dict["exp.qravan.type"],
    sum: dict["exp.qravan.sum"],
    sys: dict["exp.qravan.sys"],
    work: [dict["exp.qravan.w1"], dict["exp.qravan.w2"]],
    own: dict["exp.qravan.own"],
    result: dict["exp.qravan.result"],
  },
  {
    id: "otogo",
    company: "OTOGO LLC",
    when: "Jun 2025 — Jul 2026",
    role: dict["exp.otogo.role"],
    type: dict["exp.otogo.type"],
    sum: dict["exp.otogo.sum"],
    sys: dict["exp.otogo.sys"],
    work: [dict["exp.otogo.w1"], dict["exp.otogo.w2"], dict["exp.otogo.w3"]],
    own: dict["exp.otogo.own"],
    result: dict["exp.otogo.result"],
  },
  {
    id: "des",
    company: "Desinftec LLC",
    when: "Jul 2025 — Jun 2026",
    role: dict["exp.des.role"],
    type: dict["exp.des.type"],
    sum: dict["exp.des.sum"],
    sys: dict["exp.des.sys"],
    work: [dict["exp.des.w1"], dict["exp.des.w2"], dict["exp.des.w3"], dict["exp.des.w4"]],
    own: dict["exp.des.own"],
    result: dict["exp.des.result"],
    tags: [dict["tag.micro"]],
  },
  {
    id: "dev",
    company: "Developia Engineering Academy",
    when: "Aug 2024 — May 2026",
    role: dict["exp.dev.role"],
    type: dict["exp.dev.type"],
    sum: dict["exp.dev.sum"],
    sys: dict["exp.dev.sys"],
    work: [dict["exp.dev.w1"], dict["exp.dev.w2"], dict["exp.dev.w3"]],
    own: dict["exp.dev.own"],
    result: dict["exp.dev.result"],
    tags: [dict["tag.review"]],
  },
  {
    id: "men",
    company: "Design & Information Technologies Club",
    when: "Oct 2023 — Jul 2024",
    role: dict["exp.men.role"],
    type: dict["exp.men.type"],
    sum: dict["exp.men.sum"],
    work: [dict["exp.men.w1"], dict["exp.men.w2"]],
    result: dict["exp.men.result"],
  },
];
---
<section
  id="experience"
  class="term-section"
  data-section="experience"
  hidden
  aria-hidden="true"
  aria-labelledby="exp-title"
>
  <div class="panel">
    <h2 id="exp-title" class="panel-title" tabindex="-1">
      <span>┌─ {dict["nav.experience"]} </span><span class="rule" aria-hidden="true"></span><span aria-hidden="true">┐</span>
    </h2>
    <div class="panel-body">
      <p style="color:var(--primary);margin-bottom:6px;">{dict["exp.title"]}</p>
      <p class="lede" style="margin-bottom:12px;">{dict["exp.lead"]}</p>
      <p class="command-hint" style="margin-bottom:8px;">{dict["term.expand"]}</p>
      <ul class="job-list">
        {jobs.map((job) => (
          <li>
            <button
              type="button"
              class="job-row"
              data-job-toggle
              aria-expanded="false"
              aria-controls={`job-${job.id}`}
            >
              <span>
                {job.current && <span class="tag ok">{dict["exp.current"]}</span>}{" "}
                <strong>{job.company}</strong> — {job.role}
                {job.type && <span class="muted"> · {job.type}</span>}
              </span>
              <span class="when">{job.when}</span>
            </button>
            <div class="job-detail" id={`job-${job.id}`}>
              <p>{job.sum}</p>
              {job.sys && (
                <div>
                  <h4>{dict["label.systems"]}</h4>
                  <p>{job.sys}</p>
                </div>
              )}
              <div>
                <h4>{dict["label.work"]}</h4>
                <ul>
                  {job.work.map((w) => <li>{w}</li>)}
                </ul>
              </div>
              {job.own && (
                <div>
                  <h4>{dict["label.own"]}</h4>
                  <p>{job.own}</p>
                </div>
              )}
              <div>
                <h4>{dict["label.result"]}</h4>
                <p>{job.result}</p>
              </div>
              {job.tags && (
                <p>
                  {job.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
