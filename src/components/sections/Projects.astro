---
<section
  id="projects"
  class="term-section"
  data-section="projects"
  hidden
  aria-hidden="true"
  aria-labelledby="projects-title"
>
  <div class="panel">
    <h2 id="projects-title" class="panel-title" tabindex="-1">
      <span>┌─ {dict["nav.projects"]} </span><span class="rule" aria-hidden="true"></span><span aria-hidden="true">┐</span>
    </h2>
    <div class="panel-body">
      <p style="color:var(--primary);margin-bottom:6px;">{dict["proj.title"]}</p>
      <p class="lede" style="margin-bottom:14px;">{dict["proj.lead"]}</p>
      <div class="project-grid">
        {projects.map((p) => (
          <article class="project-box">
            <header>
              <h3>{p.name}</h3>
              <span class="tag ok">[{p.status}]</span>
              <p class="sub">{p.sub}</p>
            </header>
            <p>{p.desc}</p>
            {p.rows.map((r) => (
              <div class="meta-row">
                <span>{r.label}</span>
                <strong>{r.text}</strong>
              </div>
            ))}
            {p.tags && (
              <p style="margin-top:8px;">
                {p.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </p>
            )}
            {p.link && (
              <a class="cmd-link" href={p.link.href} rel="noopener noreferrer" target="_blank">
                {dict["term.open"]} {p.link.label}
              </a>
            )}
          </article>
        ))}
      </div>
      <p style="margin-top:14px;">
        <a class="cmd-link" href="https://github.com/agilazizovf" rel="noopener noreferrer" target="_blank">
          {dict["proj.more"]}
        </a>
      </p>
    </div>
  </div>
</section>
