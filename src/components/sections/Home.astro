---
import type { Dict } from "../../i18n";

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
---
<section
  id="home"
  class="term-section is-active"
  data-section="home"
  aria-labelledby="home-title"
>
  <div class="panel">
    <h1 id="home-title" class="panel-title" tabindex="-1">
      <span>┌─ {dict["nav.home"]} </span><span class="rule" aria-hidden="true"></span><span aria-hidden="true">┐</span>
    </h1>
    <div class="panel-body">
      <p class="kicker">{dict["hero.kicker"]}</p>
      <p style="font-family:var(--display);font-size:clamp(36px,8vw,64px);line-height:1;color:var(--primary);letter-spacing:0.04em;">
        {dict.name}
      </p>
      <p style="margin-top:8px;color:var(--text);font-size:18px;">{dict["hero.title"]}</p>
      <p class="lede" style="margin-top:14px;max-width:70ch;">{dict["hero.lede"]}</p>
      <hr class="divider" />
      <div class="meta-row"><span>{dict["hero.panel"]}</span><strong>{dict["hero.panel.role"]}</strong></div>
      <div class="meta-row"><span>{dict["hero.panel.where"]}</span><strong>Əminlər MMC</strong></div>
      <div class="meta-row"><span>{dict["about.focus"]}</span><strong>{dict["hero.panel.focus"]}</strong></div>
      <div class="meta-row"><span>{dict["about.place"]}</span><strong>{dict["about.place.v"]}</strong></div>
      <p style="margin-top:16px;">
        <a href="#experience">{dict["hero.cta"]}</a>
        <span aria-hidden="true"> · </span>
        <a class="cv-link" href="/Agil_Azizov_CV.pdf" download>{dict["cta.cv"]}</a>
      </p>
    </div>
  </div>
</section>
