---
import type { Dict } from "../../i18n";

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
---
<section
  id="about"
  class="term-section"
  data-section="about"
  hidden
  aria-hidden="true"
  aria-labelledby="about-title"
>
  <div class="panel">
    <h2 id="about-title" class="panel-title" tabindex="-1">
      <span>┌─ {dict["nav.about"]} </span><span class="rule" aria-hidden="true"></span><span aria-hidden="true">┐</span>
    </h2>
    <div class="panel-body">
      <p style="color:var(--primary);margin-bottom:12px;">{dict["about.title"]}</p>
      <div class="prose">
        <p>{dict["about.p1"]}</p>
        <p>{dict["about.p2"]}</p>
        <p>{dict["about.p3"]}</p>
      </div>
      <hr class="divider" />
      <div class="meta-row"><span>{dict["about.now"]}</span><strong>{dict["about.now.v"]}</strong></div>
      <div class="meta-row"><span>{dict["about.focus"]}</span><strong>{dict["about.focus.v"]}</strong></div>
      <div class="meta-row"><span>{dict["about.place"]}</span><strong>{dict["about.place.v"]}</strong></div>
      <div class="meta-row"><span>{dict["about.edu"]}</span><strong>{dict["about.edu.v"]}</strong></div>
      <div class="meta-row"><span>{dict["about.stack"]}</span><strong>Java · Kotlin · Spring Boot · SQL · Docker · CI/CD</strong></div>
      <hr class="divider" />
      <h3 style="color:var(--primary);font-size:14px;letter-spacing:0.06em;text-transform:uppercase;margin-bottom:8px;">{dict["edu.title"]}</h3>
      <ul class="list-plain">
        <li>{dict["edu.msc"]} — Azerbaijan Technical University</li>
        <li>{dict["edu.bsc"]} — Khazar University</li>
      </ul>
      <h3 style="color:var(--primary);font-size:14px;letter-spacing:0.06em;text-transform:uppercase;margin:14px 0 8px;">{dict["cert.title"]}</h3>
      <ul class="list-plain">
        <li>
          <a href="/images/java_basic%20certificate.pdf">{dict["cert.backend"]} — Java</a>
        </li>
        <li>
          <a href="/images/sql_basic%20certificate.pdf">SQL</a>
        </li>
        <li>
          <a href="/images/intern_intelligence.pdf">Intern Intelligence</a>
        </li>
      </ul>
    </div>
  </div>
</section>
