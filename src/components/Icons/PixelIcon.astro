---
interface Props {
  name:
    | "computer"
    | "folder"
    | "skills"
    | "projects"
    | "engineering"
    | "mail"
    | "terminal"
    | "resume"
    | "recycle"
    | "browser"
    | "start";
}
const { name } = Astro.props;
const stroke = "currentColor";
---
<svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
  {name === "computer" && (
    <>
      <rect x="4" y="6" width="28" height="18" fill="none" stroke={stroke} stroke-width="2" />
      <rect x="8" y="10" width="20" height="10" fill={stroke} opacity="0.35" />
      <rect x="14" y="24" width="8" height="3" fill={stroke} />
      <rect x="10" y="28" width="16" height="2" fill={stroke} />
    </>
  )}
  {name === "folder" && (
    <>
      <path d="M4 12h10l3 3h15v14H4V12z" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M4 15h28" stroke={stroke} stroke-width="2" />
    </>
  )}
  {name === "skills" && (
    <>
      <circle cx="18" cy="18" r="10" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M18 8v4M18 24v4M8 18h4M24 18h4" stroke={stroke} stroke-width="2" />
      <rect x="15" y="15" width="6" height="6" fill={stroke} />
    </>
  )}
  {name === "projects" && (
    <>
      <rect x="6" y="8" width="10" height="10" fill="none" stroke={stroke} stroke-width="2" />
      <rect x="20" y="8" width="10" height="10" fill="none" stroke={stroke} stroke-width="2" />
      <rect x="6" y="20" width="10" height="10" fill="none" stroke={stroke} stroke-width="2" />
      <rect x="20" y="20" width="10" height="10" fill={stroke} opacity="0.4" />
    </>
  )}
  {name === "engineering" && (
    <>
      <rect x="4" y="8" width="8" height="8" fill="none" stroke={stroke} stroke-width="2" />
      <rect x="14" y="14" width="8" height="8" fill="none" stroke={stroke} stroke-width="2" />
      <rect x="24" y="20" width="8" height="8" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M12 12h2M22 18h2" stroke={stroke} stroke-width="2" />
    </>
  )}
  {name === "mail" && (
    <>
      <rect x="5" y="10" width="26" height="16" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M5 10l13 9 13-9" fill="none" stroke={stroke} stroke-width="2" />
    </>
  )}
  {name === "terminal" && (
    <>
      <rect x="4" y="6" width="28" height="24" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M9 14l5 4-5 4" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M16 22h10" stroke={stroke} stroke-width="2" />
    </>
  )}
  {name === "resume" && (
    <>
      <path d="M10 4h12l6 6v22H10V4z" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M22 4v6h6" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M14 16h10M14 20h10M14 24h7" stroke={stroke} stroke-width="2" />
    </>
  )}
  {name === "recycle" && (
    <>
      <path d="M12 8l4-4 4 4M18 4v10" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M10 14l-3 8h22l-3-8" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M14 18v6M18 18v6M22 18v6" stroke={stroke} stroke-width="2" />
    </>
  )}
  {name === "browser" && (
    <>
      <rect x="4" y="6" width="28" height="24" fill="none" stroke={stroke} stroke-width="2" />
      <path d="M4 12h28" stroke={stroke} stroke-width="2" />
      <circle cx="8" cy="9" r="1.5" fill={stroke} />
      <circle cx="13" cy="9" r="1.5" fill={stroke} />
    </>
  )}
  {name === "start" && (
    <>
      <rect x="6" y="6" width="10" height="10" fill={stroke} />
      <rect x="20" y="6" width="10" height="10" fill={stroke} opacity="0.7" />
      <rect x="6" y="20" width="10" height="10" fill={stroke} opacity="0.7" />
      <rect x="20" y="20" width="10" height="10" fill={stroke} opacity="0.45" />
    </>
  )}
</svg>
