---
import type { Dict, Locale } from "../../i18n";
import StatusBar from "./StatusBar.astro";
import CommandLine from "./CommandLine.astro";
import BootSequence from "./BootSequence.astro";
import CrtOverlay from "./CrtOverlay.astro";
import Home from "../sections/Home.astro";
import About from "../sections/About.astro";
import Experience from "../sections/Experience.astro";
import Skills from "../sections/Skills.astro";
import Projects from "../sections/Projects.astro";
import Engineering from "../sections/Engineering.astro";
import Contact from "../sections/Contact.astro";

interface Props {
  dict: Dict;
  locale: Locale;
}
const { dict, locale } = Astro.props;
---
<div class="terminal-shell" data-terminal>
  <StatusBar dict={dict} locale={locale} />
  <main id="main" class="terminal-main" tabindex="-1">
    <div class="visually-hidden" data-term-live aria-live="polite"></div>
    <p class="command-hint" data-resume-line hidden style="max-width:90ch;margin:0 auto 12px;">{dict["term.resume"]}</p>
    <Home dict={dict} />
    <About dict={dict} />
    <Experience dict={dict} />
    <Skills dict={dict} />
    <Projects dict={dict} />
    <Engineering dict={dict} />
    <Contact dict={dict} />
  </main>
  <CommandLine dict={dict} />
  <BootSequence dict={dict} />
</div>
<CrtOverlay />
