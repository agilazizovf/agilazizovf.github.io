---
import type { Dict, Locale } from "../../i18n";
import { pathForLocale } from "../../i18n";

interface Props {
  dict: Dict;
  locale: Locale;
}
const { dict, locale } = Astro.props;

const sections = [
  { id: "home", label: dict["nav.home"] },
  { id: "about", label: dict["nav.about"] },
  { id: "experience", label: dict["nav.experience"] },
  { id: "skills", label: dict["nav.skills"] },
  { id: "projects", label: dict["nav.projects"] },
  { id: "engineering", label: dict["nav.engineering"] },
  { id: "contact", label: dict["nav.contact"] },
] as const;

const langs: { code: Locale; label: string }[] = [
  { code: "en", label: "EN" },
  { code: "az", label: "AZ" },
  { code: "ru", label: "RU" },
];
---
<header class="status-bar" role="banner">
  <div class="status-os" aria-label={dict["term.os"]}>{dict["term.os"]}</div>
  <nav class="status-nav" aria-label="Primary">
    {sections.map((s) => (
      <a href={`#${s.id}`} data-section-link>{s.label}</a>
    ))}
  </nav>
  <div class="status-tools">
    {langs.map((l) => (
      <a
        href={pathForLocale(l.code)}
        class:list={{ "is-active": locale === l.code }}
        data-lang-link
        hreflang={l.code}
        lang={l.code}
        aria-current={locale === l.code ? "true" : undefined}
      >
        {l.label}
      </a>
    ))}
    <button
      type="button"
      data-tool-mute
      aria-pressed="false"
      data-label-mute={dict["term.mute"]}
      data-label-unmute={dict["term.unmute"]}
    >
      {dict["term.mute"]}
    </button>
    <button type="button" data-tool-crt aria-pressed="true" aria-label={dict["term.crt"]}>
      {dict["term.crt"]}
    </button>
  </div>
</header>
