---
import type { Dict } from "../../i18n";
import WindowShell from "../Window/WindowShell.astro";

interface Props { dict: Dict; }
const { dict } = Astro.props;
---
<WindowShell id="about" title={dict["os.about.title"]}>
  <div class="tabs" role="tablist" data-tabs="about">
    <button type="button" class="is-active" role="tab" aria-selected="true" data-tab="general">{dict["os.tab.general"]}</button>
    <button type="button" role="tab" aria-selected="false" data-tab="education">{dict["edu.title"]}</button>
    <button type="button" role="tab" aria-selected="false" data-tab="certs">{dict["cert.title"]}</button>
  </div>
  <div data-tab-panel="general">
    <p style="color:var(--primary);margin-bottom:10px;">{dict["about.title"]}</p>
    <p style="color:var(--muted);margin-bottom:8px;">{dict["about.p1"]}</p>
    <p style="color:var(--muted);margin-bottom:8px;">{dict["about.p2"]}</p>
    <p style="color:var(--muted);margin-bottom:12px;">{dict["about.p3"]}</p>
    <div class="meta-row"><span>{dict["about.now"]}</span><strong>{dict["about.now.v"]}</strong></div>
    <div class="meta-row"><span>{dict["about.focus"]}</span><strong>{dict["about.focus.v"]}</strong></div>
    <div class="meta-row"><span>{dict["about.place"]}</span><strong>{dict["about.place.v"]}</strong></div>
    <div class="meta-row"><span>{dict["about.stack"]}</span><strong>Java · Kotlin · Spring Boot · SQL · Docker</strong></div>
  </div>
  <div data-tab-panel="education" hidden>
    <ul class="list-plain">
      <li>{dict["edu.msc"]} — Azerbaijan Technical University</li>
      <li>{dict["edu.bsc"]} — Khazar University</li>
    </ul>
  </div>
  <div data-tab-panel="certs" hidden>
    <ul class="list-plain">
      <li><a href="/images/java_basic%20certificate.pdf">{dict["cert.backend"]} — Java</a></li>
      <li><a href="/images/sql_basic%20certificate.pdf">SQL</a></li>
      <li><a href="/images/intern_intelligence.pdf">Intern Intelligence</a></li>
    </ul>
  </div>
</WindowShell>
